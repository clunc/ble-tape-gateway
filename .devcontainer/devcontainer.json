{
  "name": "BlueZ Bluetooth Development",
  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      "USER_UID": "1000",
      "USER_GID": "1000",
      "BLUETOOTH_GID": "113"
    }
  },

  "capAdd": [
    "NET_ADMIN",
    "NET_RAW"
  ],

  "runArgs": [
    "--security-opt",
    "apparmor=unconfined",
    "--security-opt",
    "seccomp=unconfined",
    "--network=host",
    "--device",
    "/dev/bus/usb"
  ],

  "mounts": [
    "source=/run/dbus,target=/run/dbus,type=bind,readonly",
    "source=${env:SSH_AUTH_SOCK},target=/ssh-agent,type=bind",
    "source=${localEnv:HOME}/.gitconfig,target=/home/vscode/.gitconfig,type=bind"
  ],

  "remoteUser": "vscode",

  "containerEnv": {
    "DBUS_SYSTEM_BUS_ADDRESS": "unix:path=/run/dbus/system_bus_socket",
    "SSH_AUTH_SOCK": "/ssh-agent"
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "yzhang.markdown-all-in-one",
        "davidanson.vscode-markdownlint",
        "redhat.vscode-yaml",
        "golang.go",
        "anthropic.claude-code",
        "openai.codex"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "codex.model": "gpt-5-codex",
        "codex.reasoningEffort": "medium",
        "codex.defaultMode": "agent",
        "codex.enableAutoContext": true,
        "codex.allowFileEdits": true,
        "codex.allowTerminalCommands": "ask"
      }
    }
  },

  "postCreateCommand": "mkdir -p ~/.claude && claude --version && mkdir -p ~/.codex && codex --version"
}
